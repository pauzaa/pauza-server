# Development environment for local Docker Compose (Traefik reverse proxy).
# This file is safe to keep in git because it contains local-only dummy values.
# Usage:
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml run --rm api ./pauza-migrate

PORT=8080
LOG_LEVEL=info
TRUSTED_PROXIES=172.30.0.0/24

POSTGRES_USER=pauza
POSTGRES_PASSWORD=pauza_dev_password
POSTGRES_DB=pauza
DATABASE_URL=postgres://pauza:pauza_dev_password@db:5432/pauza?sslmode=disable

JWT_SECRET=dev-jwt-secret-change-me-in-prod!
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h

# Local development uses Mailpit instead of a real provider so OTP emails are
# captured locally and never sent to real inboxes.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=dev
SMTP_PASSWORD=dev
SMTP_FROM=no-reply@pauza.local
SMTP_TIMEOUT=5s
SMTP_TLS_POLICY=none

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin_dev_password

REVENUECAT_API_KEY=dev
REVENUECAT_WEBHOOK_SECRET=dev

# Local push testing:
# - leave empty to disable push locally (the server falls back to the noop sender)
# - or paste the real Firebase service-account JSON as a single-line value to
#   exercise push notifications end-to-end in development
FIREBASE_SERVICE_ACCOUNT_JSON=

REDIS_URL=redis://redis:6379/0

PHOTO_STORAGE_DIR=/var/lib/pauza/photos
PHOTO_PUBLIC_BASE_URL=http://localhost:8080/photos

# AI analysis (optional; leave AI_PROVIDER empty to disable AI endpoints)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=
# AI_MODEL=
# AI_RATE_LIMIT=10
# AI_RATE_WINDOW=1h

CLEANUP_INTERVAL=1h
OTP_RETENTION_PERIOD=24h
REFRESH_TOKEN_REVOKED_RETENTION=168h
