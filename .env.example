# Copy this file to .env and fill in real values.
# Never commit .env to git.

# Server
PORT=8080
LOG_LEVEL=info
# Comma-separated IPs or CIDRs whose forwarded headers (X-Forwarded-For,
# X-Real-Ip) are trusted. Empty means trust nobody (safe default).
# Example: TRUSTED_PROXIES=172.16.0.0/12,10.0.0.1
TRUSTED_PROXIES=

# Database
DATABASE_URL=postgres://pauza:pauza_dev_password@db:5432/pauza?sslmode=disable

# JWT (JWT_SECRET must be at least 32 characters; use a cryptographically random value in production)
JWT_SECRET=dev-jwt-secret-change-me-in-prod!
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=dev
SMTP_PASSWORD=dev
SMTP_FROM=noreply@pauza.app
SMTP_TIMEOUT=30s
# TLS policy: mandatory (default), opportunistic, or none
SMTP_TLS_POLICY=mandatory

# Admin seed (used by cmd/seed-admin only; not required for server startup)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin_dev_password

# RevenueCat
REVENUECAT_API_KEY=placeholder
REVENUECAT_WEBHOOK_SECRET=placeholder

# Firebase
FIREBASE_SERVICE_ACCOUNT_JSON=placeholder

# Student Verification
STUDENT_VERIFICATION_PROVIDER=sheerid
STUDENT_VERIFICATION_API_KEY=placeholder

# Rate limiting (optional; safe defaults apply if omitted)
# AUTH_RATE_LIMIT=5
# AUTH_RATE_WINDOW=1m
# VERIFY_OTP_RATE_LIMIT=3
# VERIFY_OTP_RATE_WINDOW=1m

# Cleanup job (how often to run, and how long to keep old auth data)
CLEANUP_INTERVAL=1h
OTP_RETENTION_PERIOD=24h
REFRESH_TOKEN_REVOKED_RETENTION=168h
