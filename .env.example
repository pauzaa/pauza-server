# Copy this file to .env and fill in real values.
# Never commit .env to git.

# Server
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://pauza:pauza_dev_password@db:5432/pauza?sslmode=disable

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=dev
SMTP_PASSWORD=dev
SMTP_FROM=noreply@pauza.app

# Admin seed (created on first startup when admin_credentials table is empty)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin_dev_password

# RevenueCat
REVENUECAT_API_KEY=placeholder
REVENUECAT_WEBHOOK_SECRET=placeholder

# Firebase
FIREBASE_SERVICE_ACCOUNT_JSON=placeholder

# Student Verification
STUDENT_VERIFICATION_PROVIDER=sheerid
STUDENT_VERIFICATION_API_KEY=placeholder
