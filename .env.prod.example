# Production-style environment for single-host full-stack Docker Compose.
# Replace every placeholder value before use.
# Usage:
#   cp .env.prod.example .env.prod
#   Edit .env.prod and the placeholder API image in docker-compose.prod.yml.
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml pull
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d db redis
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml run --rm api ./pauza-migrate
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

PORT=8080
LOG_LEVEL=info
TRUSTED_PROXIES=172.30.0.0/24

PUBLIC_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com

POSTGRES_USER=pauza
POSTGRES_PASSWORD=replace_me_postgres_password
POSTGRES_DB=pauza
DATABASE_URL=postgres://pauza:replace_me_postgres_password@db:5432/pauza?sslmode=disable

JWT_SECRET=replace-with-a-32-byte-minimum-production-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h

# Production uses Resend SMTP. Replace the password with your real Resend SMTP
# credential after verifying your sending domain (for example mail.pauza.dev).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=replace_me
SMTP_FROM=noreply@mail.pauza.dev
SMTP_TIMEOUT=30s
SMTP_TLS_POLICY=mandatory

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=replace_me

REVENUECAT_API_KEY=replace_me
REVENUECAT_WEBHOOK_SECRET=replace_me

FIREBASE_SERVICE_ACCOUNT_JSON=

REDIS_URL=redis://redis:6379/0

PHOTO_STORAGE_DIR=/var/lib/pauza/photos
PHOTO_PUBLIC_BASE_URL=https://api.example.com/photos

CLEANUP_INTERVAL=1h
OTP_RETENTION_PERIOD=24h
REFRESH_TOKEN_REVOKED_RETENTION=168h
