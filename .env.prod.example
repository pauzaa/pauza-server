# Production environment for single-host full-stack Docker Compose (Traefik reverse proxy + ACME TLS).
# Replace every placeholder value before use.
# Usage:
#   cp .env.prod.example .env.prod
#   Edit .env.prod with your production values.
#   For every docker compose command below, --env-file .env.prod is required so
#   Compose can substitute IMAGE_TAG, PUBLIC_DOMAIN, LETSENCRYPT_EMAIL, etc.
#   (service `env_file` alone does not set variables for the compose file itself.)
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod pull
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d db redis
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod run --rm api ./pauza-migrate
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod logs -f api
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod ps -a

PORT=8080
LOG_LEVEL=info
# For the bundled Traefik stack, keep the default subnet below.
# If you deploy behind an existing shared Traefik network, set this to that
# network's subnet instead (for example 172.18.0.0/16).
TRUSTED_PROXIES=172.30.0.0/24
IMAGE_TAG=latest

PUBLIC_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com

POSTGRES_USER=pauza
POSTGRES_PASSWORD=replace_me_postgres_password
POSTGRES_DB=pauza
DATABASE_URL=postgres://pauza:replace_me_postgres_password@db:5432/pauza?sslmode=disable

JWT_SECRET=replace-with-a-32-byte-minimum-production-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h

# Production uses Resend SMTP. Replace the password with your real Resend SMTP
# credential after verifying your sending domain (for example mail.pauza.dev).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=replace_me
SMTP_FROM=noreply@mail.pauza.dev
SMTP_TIMEOUT=30s
SMTP_TLS_POLICY=mandatory

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=replace_me

REVENUECAT_API_KEY=replace_me
REVENUECAT_WEBHOOK_SECRET=replace_me

# RevenueCat v2 API (optional; enables admin RC analytics endpoints)
REVENUECAT_V2_SECRET_KEY=
REVENUECAT_PROJECT_ID=

ADMIN_CORS_ORIGINS=

FIREBASE_SERVICE_ACCOUNT_JSON=

REDIS_PASSWORD=replace_me_redis_password
REDIS_URL=redis://:replace_me_redis_password@redis:6379/0

PHOTO_STORAGE_DIR=/var/lib/pauza/photos
PHOTO_PUBLIC_BASE_URL=https://api.example.com/photos

# AI analysis (leave AI_PROVIDER empty to disable AI endpoints)
AI_PROVIDER=openai
OPENAI_API_KEY=replace_me
# GEMINI_API_KEY=
# AI_MODEL=
AI_RATE_LIMIT=10
AI_RATE_WINDOW=1h

CLEANUP_INTERVAL=1h
OTP_RETENTION_PERIOD=24h 
REFRESH_TOKEN_REVOKED_RETENTION=168h
SESSION_MAX_AGE=168h
